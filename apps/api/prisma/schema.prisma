// Cơ sở dữ liệu website Trường THPT Lê Quý Đôn – Hà Đông

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  TEACHER
}

enum UserStatus {
  ACTIVE
  LOCKED
}

enum PostStatus {
  DRAFT
  PENDING
  PUBLISHED
}

enum Tone {
  BRAND
  NEUTRAL
  SUCCESS
  WARNING
  DANGER
}

enum CommentStatus {
  PENDING
  APPROVED
  SPAM
}

enum QuestionStatus {
  PENDING
  ANSWERED
  HIDDEN
}

enum FeedbackStatus {
  NEW
  SEEN
  RESOLVED
}

enum ClubStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BannerPosition {
  HOME
  SIDEBAR
  FOOTER
}

enum LinkPosition {
  HOME
  FOOTER
}

/// Tài khoản truy cập trang quản trị
model User {
  id           String     @id @default(cuid())
  username     String     @unique
  email        String     @unique
  passwordHash String
  fullName     String
  role         Role       @default(TEACHER)
  department   String?
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  posts        Post[]
}

/// Chuyên mục (cây) quyết định menu và đường dẫn bài viết
model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  order       Int        @default(0)
  showInMenu  Boolean    @default(true)
  posts       Post[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

/// Tin bài
model Post {
  id            String     @id @default(cuid())
  title         String
  slug          String     @unique
  excerpt       String?
  content       String     @default("")
  thumbnail     String?
  imageCaption  String?
  categoryId    String?
  category      Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId      String?
  author        User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  /// Tên hiển thị của người/đơn vị đăng (vd: "Đoàn trường")
  authorName    String?
  status        PostStatus @default(DRAFT)
  publishedAt   DateTime?
  featured      Boolean    @default(false)
  allowComments Boolean    @default(true)
  /// Nhãn nhấn trong danh sách thông báo (vd: "Khẩn", "Hạn chót")
  badge         String?
  badgeTone     Tone?
  views         Int        @default(0)
  comments      Comment[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
}

/// Phản hồi bài viết — chỉ hiển thị sau khi duyệt
model Comment {
  id        String        @id @default(cuid())
  postId    String
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  content   String
  status    CommentStatus @default(PENDING)
  ip        String?
  createdAt DateTime      @default(now())

  @@index([status])
}

/// Văn bản pháp quy
model LegalDocument {
  id        String    @id @default(cuid())
  code      String?
  title     String
  issuer    String
  type      String
  issuedAt  DateTime?
  effective Boolean   @default(true)
  visible   Boolean   @default(true)
  fileUrl   String?
  fileName  String?
  fileSize  Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Dòng chữ chạy dưới thanh điều hướng trang chủ
model TickerItem {
  id        String    @id @default(cuid())
  text      String
  link      String?
  startAt   DateTime?
  endAt     DateTime?
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Ảnh giới thiệu = slide trang chủ
model Slide {
  id             String   @id @default(cuid())
  eyebrow        String?
  title          String
  lead           String?
  ctaLabel       String?
  ctaHref        String?
  secondaryLabel String?
  secondaryHref  String?
  image          String?
  imageAlt       String?
  caption        String?
  order          Int      @default(0)
  visible        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Album {
  id          String       @id @default(cuid())
  title       String
  description String?
  coverUrl    String?
  eventDate   DateTime?
  schoolYear  String?
  visible     Boolean      @default(true)
  photos      AlbumPhoto[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model AlbumPhoto {
  id        String   @id @default(cuid())
  albumId   String
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

/// Kiểu thư viện (Ảnh, Video, Bài giảng, Tài liệu)
model LibraryType {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  description    String?
  allowedFormats String?
  order          Int           @default(0)
  visible        Boolean       @default(true)
  items          LibraryItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model LibraryItem {
  id          String      @id @default(cuid())
  title       String
  description String?
  typeId      String
  type        LibraryType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  fileUrl     String?
  fileName    String?
  mimeType    String?
  fileSize    Int?
  externalUrl String?
  thumbnail   String?
  visible     Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

/// Biểu mẫu, tài liệu cho phụ huynh/học sinh tải về
model DownloadFile {
  id        String   @id @default(cuid())
  name      String
  category  String
  fileUrl   String?
  fileName  String?
  mimeType  String?
  fileSize  Int?
  downloads Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Question {
  id         String         @id @default(cuid())
  question   String
  askerName  String
  askerRole  String?
  askerEmail String?
  topic      String
  answer     String?
  answeredBy String?
  answeredAt DateTime?
  status     QuestionStatus @default(PENDING)
  ip         String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model Feedback {
  id        String         @id @default(cuid())
  name      String
  role      String
  email     String
  phone     String?
  title     String
  content   String
  note      String?
  status    FeedbackStatus @default(NEW)
  ip        String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

/// Đăng ký câu lạc bộ kết bạn – giao lưu
model ClubMember {
  id           String     @id @default(cuid())
  fullName     String
  className    String
  hobbies      String?
  language     String?
  email        String?
  phone        String?
  introduction String?
  status       ClubStatus @default(PENDING)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Banner {
  id          String         @id @default(cuid())
  name        String
  eyebrow     String?
  title       String?
  description String?
  ctaLabel    String?
  link        String?
  image       String?
  size        String?
  position    BannerPosition @default(HOME)
  startAt     DateTime?
  endAt       DateTime?
  clicks      Int            @default(0)
  visible     Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

/// Liên kết hữu ích (trang chủ, chân trang)
model Link {
  id         String       @id @default(cuid())
  name       String
  url        String?
  sub        String?
  icon       String?
  position   LinkPosition @default(HOME)
  openNewTab Boolean      @default(true)
  visible    Boolean      @default(true)
  order      Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}
