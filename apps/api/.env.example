PORT=4000
DATABASE_URL=postgresql://lqd:lqd_secret@localhost:5433/lqd_hadong?schema=public
REDIS_URL=redis://localhost:6380

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
# Thời hạn token (giây)
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Danh sách origin được gọi API trực tiếp từ trình duyệt (phân cách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:3000

# Thư mục lưu tệp tải lên (ảnh, văn bản, file download)
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=50

SEED_ADMIN_PASSWORD=Admin@123
