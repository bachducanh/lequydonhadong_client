# Biến môi trường cho docker compose (sao chép thành .env)
POSTGRES_USER=lqd
POSTGRES_PASSWORD=lqd_secret
POSTGRES_DB=lqd_hadong
POSTGRES_PORT=5433
REDIS_PORT=6380
API_PORT=4000
WEB_PORT=3000

# Đổi hai khoá này khi triển khai thật (chuỗi ngẫu nhiên >= 32 ký tự)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

CORS_ORIGINS=http://localhost:3000
SITE_URL=http://localhost:3000

# Lần chạy đầu tiên tạo dữ liệu mẫu + tài khoản quản trị (admin / SEED_ADMIN_PASSWORD)
SEED_ON_START=true
SEED_ADMIN_PASSWORD=Admin@123
